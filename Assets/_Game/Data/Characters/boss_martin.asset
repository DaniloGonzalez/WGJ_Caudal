  dialogueLines:
  - trigger: 1
    text: "\xA1Otro d\xEDa en la oficina!\n"
    duration: 3
  - trigger: 1
    text: "\xA1No hay problema!\n"
    duration: 3
  - trigger: 1
    text: "Ojal\xE1 crezcamos como equipo\n"
    duration: 3
  - trigger: 1
    text: 'Aww mi jefa siempre sabe lo que necesitamos

'
    duration: 3
  - trigger: 1
    text: "Si te dan mucho trabajo, es porque conf\xEDan en ti\n"
    duration: 3
  - trigger: 1
    text: 'Si quieres buenos resultados, el buen trabajo y un buen liderazgo son prioridad

'
    duration: 3
  - trigger: 1
    text: 'Aww mi jefa siempre sabe lo que necesitamos

'
    duration: 3
