  m_Script: {fileID: 11500000, guid: 503c1fd2e0a8cd0409bc762d7568a45a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Caudal.IntroPanel
  messageLabel: {fileID: 948866406903527569}
  closingMessageLabel: {fileID: 2381683675018066246}
  introMessage: "DMM LTDA.\nCIRCULAR INFORMATIVA N\xB085\n<size=18><b>ASUNTO: IMPLEMENTACI\xD3N DE SENSORES</b></size>\n\nEN LAS OFICINAS DE DMM LTDA. NOS TOMAMOS LA <b>PRODUCTIVIDAD</b> Y EL <b>AMBIENTE LABORAL</b> MUY EN SERIO.\n\nCOMO EMPRESA L\xCDDER Y PIONERA EN MEDICI\xD3N, Y EN RECONOCIMIENTO A LA EXCELENCIA DEL YA CONOCIDO Y ADMIRADO MEDIDOR <b>MORADO DE PRODUCTIVIDAD</b>, DESDE EL D\xCDA DE HOY DAMOS UN NUEVO PASO AL FUTURO E INVITAMOS A TODOS LOS Y LAS TRABAJADORES, JUNTO A SUS JEFATURAS, A USAR LOS <b>SENSORES VERDES DE BIENESTAR</b>.\n\n<b>ESTOS INNOVADORES DISPOSITIVOS</b> NOS PERMITIR\xC1N MEDIR EN TIEMPO REAL SUS NIVELES DE <b>ESTR\xC9S, COMPROMISO, FELICIDAD Y TRISTEZA</b>. TODO A TRAV\xC9S DE UNA LINDA APP DE GATITO."
  closingMessage: "AGRADECEMOS DE ANTEMANO SU ENTUSIASTA PARTICIPACI\xD3N Y LES DESEAMOS UNA EXCELENTE, AGRADABLE Y, SOBRE TODO, <b>PRODUCTIVA SEMANA</b> EN LA OFICINA.\n\nSIN NING\xDAN OTRO PARTICULAR,\nRR. HH.\n\n<b>PD:</b> EL USO DE LOS SENSORES ES DE CAR\xC1CTER <b>OBLIGATORIO</b>."
  continueButton: {fileID: 5723848395636564799}
